# SmartTeamFoundation Configuration

# Server Port
PORT=5000
NODE_ENV=development

# JWT Secret for Session Authentication
JWT_SECRET=smart_team_foundation_jwt_secret_key_2026_secure
JWT_EXPIRES_IN=7d

# Database Configuration
# Default is 'sqlite' which runs with zero configuration and persistent file storage.
# Set to 'mysql' to use MySQL Server.
DB_CLIENT=sqlite
SQLITE_DB_PATH=./data/smartteam.sqlite

# MySQL Configuration (used only when DB_CLIENT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smartteam_foundation

# Recommendation Engine Weights (Total = 100%)
WEIGHT_SKILL_OVERLAP=40
WEIGHT_PROFICIENCY=20
WEIGHT_INTERESTS=15
WEIGHT_ROLES=10
WEIGHT_EXPERIENCE=10
WEIGHT_AVAILABILITY=5
